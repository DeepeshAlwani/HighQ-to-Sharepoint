# Copy to .env (never commit .env). Docker Compose reads it for the backend.
HIGHQ_INSTANCE_URL=https://mishcondereya.highqsolutions.com/mishcondereya
HIGHQ_CLIENT_ID=
HIGHQ_CLIENT_SECRET=
# Must match the redirect URI registered on the HighQ API app exactly
HIGHQ_REDIRECT_URI=http://localhost:8080/callback
HIGHQ_API_VERSION=20
APP_FRONTEND_URL=http://localhost:5173

# SharePoint via Microsoft Graph. Leave these out to use the local SharePoint mock (docker compose).
# Real values come from an Entra ID app registration ("Web" platform) with delegated permissions
# offline_access, openid, profile, User.Read, Sites.ReadWrite.All. Users sign in with their own account.
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# GRAPH_AUTHORIZE_URL=https://login.microsoftonline.com/organizations/oauth2/v2.0/authorize
# GRAPH_TOKEN_URL=https://login.microsoftonline.com/organizations/oauth2/v2.0/token
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_REDIRECT_URI=http://localhost:8080/auth/microsoft/callback
